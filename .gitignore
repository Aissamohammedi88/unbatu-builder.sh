# Build and Release Folders
bin-debug/
bin-release/
[Oo]bj/
[Bb]in/

# Other files and folders
.settings/

# Executables
*.swf
*.air
*.ipa
*.apk

# Project files, i.e. `.project`, `.actionScriptProperties` and `.flexProperties`
# should NOT be excluded as they contain compiler settings and other important
# information for Eclipse / Flash Builder.

---

### 📄 `.gitignore`

```gitignore
# ═══════════════════════════════════════════════════════════════════
# nexOS — .gitignore
# ═══════════════════════════════════════════════════════════════════

# --- BUILD ARTIFACTS ---
# These are generated during the build process and should not be committed.
/dist/
*.iso
*.img
*.squashfs
*.vbox
*.vdi

# --- SOURCE FILES (Downloaded during build) ---
# These are downloaded by build.sh. Committing them bloats the repo.
/alpine-minirootfs-*.tar.gz
/vmlinuz-*
/initramfs-*
/ollama
/qwen2.5-*.gguf

# --- CHROOT/PROOT ENVIRONMENT ---
# The temporary chroot environment created by proot.
/rootfs/
/proot-env/

# --- LOGS & TEMP ---
*.log
logs/
tmp/
temp/

# --- OS & EDITORS ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- SECRETS ---
.env
*.pem
*.key
